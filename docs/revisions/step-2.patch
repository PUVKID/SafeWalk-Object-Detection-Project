+    "\n",
+    "# ---- COCO 다운로드 (네트워크 오류 자동 재시도) ----\n",
+    "print(\"\\n\" + \"=\" * 60)\n",
+    "print(\" COCO 2017 다운로드 (bicycle / car / motorcycle / person)\")\n",
